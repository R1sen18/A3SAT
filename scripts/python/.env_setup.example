# A3Bot configuration — normally generated interactively by install.ps1.
# Copy to .env_setup and fill in manually only if you skip the installer.
BOT_TOKEN=your_bot_token_here
GUILD_ID=your_discord_server_id_here
AUTHORIZED_USER_IDS=your_discord_user_id_here

# Windows Services
SERVICE_NAME=Arma3Server
HC_SERVICE_NAME=Arma3HeadlessClient

# A2S query (joinability polling / player count)
QUERY_HOST=127.0.0.1
QUERY_PORT=2303

# Steam username with a cached SteamCMD login on this machine.
# Enables /download (automated mod downloads). Leave empty for manual scripts.
STEAM_USERNAME=

# Arma server passwords (written into server.cfg by /setup_apply — never asked via Discord)
SERVER_PASSWORD=
ADMIN_PASSWORD=changeme
# Paths — defaults shown; only change if your layout differs
# SERVER_BASE=C:\steamgames\a3server
# WORKSHOP_BASE=C:\steamcmd\steamapps\workshop\content\107410
# STEAMCMD=C:\steamcmd\steamcmd.exe
